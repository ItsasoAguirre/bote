# Optional. Copy as .env.local only if you need to override something.
# The Supabase URL and key of each environment live in app.config.ts (see supabase/README.md);
# EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_KEY are no longer used.

